# ============================================================
#  VOYAGÉO : fichier de configuration (modèle)
#  Copiez ce fichier en ".env" puis remplissez les valeurs.
#  Ne mettez JAMAIS le fichier ".env" sur GitHub.
#  Si une valeur contient le caractère #, mettez-la entre "guillemets".
# ============================================================

# ---------- Serveur ----------
NODE_ENV=development
PORT=3000
# Adresse publique du site (sans "/" final). Utilisée dans les e-mails, les QR codes et le retour de paiement.
APP_BASE_URL=http://localhost:3000
# Clé secrète des sessions : une longue phrase aléatoire (obligatoire en production).
SESSION_SECRET=changez-moi-par-une-longue-phrase-aleatoire

# ---------- Compte administrateur (créé automatiquement au démarrage) ----------
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD="ChangezMoi#2026"
ADMIN_NOM=Administrateur
ADMIN_PRENOM=Voyageo

# ---------- Base de données ----------
# json   : fichier local data/db.json (développement, aucune installation)
# mysql  : MySQL 8.0.16+ (adaptateur src/db/adapters/mysql.js). MariaDB / XAMPP NON compatibles.
#          Créer la base avec database/voyageo_mysql_production.sql, puis voyageo_extensions_site.sql, puis voyageo_compte_applicatif.sql
#          (DB_USER=voyageo_app ; DB_PASSWORD = le mot de passe choisi dans voyageo_compte_applicatif.sql, jamais root).
#          Repasser à DB_DRIVER=json pour revenir au fichier local data/db.json.
# custom : votre propre adaptateur src/db/adapters/custom.js (voir docs)
DB_DRIVER=mysql
JSON_DB_FILE=./data/db.json
DB_HOST=localhost
DB_PORT=3306
DB_USER=voyageo_app
DB_PASSWORD=
DB_NAME=voyageo
DB_CONNECTION_LIMIT=10

# ---------- Service client WhatsApp ----------
# Numéro au format international sans + ni espaces (229 = Bénin). Affiché dans le bot, le pied de page et le bouton WhatsApp.
WHATSAPP_NUMBER=22960315810
WHATSAPP_DISPLAY="+229 60 31 58 10"

# Données de démonstration (compagnies et trajets fictifs) créées si la base est vide
DEMO_DATA=false

# ---------- Règles de réservation ----------
ANNULATION_HEURES=24
RESERVATION_ATTENTE_MINUTES=15
CLOTURE_RESERVATION_MINUTES=30
TIMEZONE_OFFSET=+01:00

# ---------- Paiement en ligne (OPTIONNEL) ----------
# off        : pas de paiement, la réservation est confirmée directement
# simulation : faux paiement Mobile Money pour la démonstration (aucune vraie transaction)
# fedapay    : vrai paiement via FedaPay (commencer par FEDAPAY_ENV=sandbox)
# FedaPay : mettre PAYMENT_MODE=fedapay, remplir les deux clés, et que APP_BASE_URL soit l'adresse publique du site (le voyageur y revient après paiement).
# Dans FedaPay > Développeurs > Webhooks, ajouter : APP_BASE_URL/paiement/webhook (événement transaction.approved) pour confirmer le ticket même si le voyageur ferme la page.
PAYMENT_MODE=off
FEDAPAY_ENV=sandbox
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
# KkiaPay (non implémenté : voir src/payments/kkiapay.js)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=

# ---------- Code de confirmation par e-mail ----------
# true : à l'inscription, un code à 6 chiffres est envoyé par e-mail ; le compte n'est créé qu'après saisie du code.
# Sert aussi à « Mot de passe oublié ». Nécessite le réglage SMTP ci-dessous (sinon, en développement, le code s'affiche dans la console).
EMAIL_VERIFICATION=true
CODE_VALIDITE_MINUTES=15

# ---------- E-mail (nécessaire pour les codes et l'envoi des tickets) ----------
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=votre.adresse@gmail.com,
# SMTP_PASS = « mot de passe d'application » à 16 lettres (https://myaccount.google.com/apppasswords, validation en 2 étapes requise),
# MAIL_FROM="Voyagéo <votre.adresse@gmail.com>"
# Laissez SMTP_HOST vide pour désactiver l'envoi d'e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Voyagéo <no-reply@exemple.com>"

# ---------- Agences de transport : abonnement et clés de paiement ----------
# Prix et durée de l'abonnement payé par une agence qui s'inscrit elle-même (versé sur VOTRE compte FedaPay, défini plus haut).
SUBSCRIPTION_PRICE_FCFA=20000
SUBSCRIPTION_DURATION_DAYS=30
# Clé qui CHIFFRE les clés FedaPay saisies par les agences. Longue phrase aléatoire, à garder secrète et à NE PLUS CHANGER
# (sinon les agences devront ressaisir leurs clés). Si vide : SESSION_SECRET est utilisée.
ENCRYPTION_KEY=
